      <div>
        <strong>Liens</strong><br />
        <a href="<%= (origin || '').replace(/\/$/, '/') %>">Accueil</a><br />
        <a href="<%= (origin || '') + '/blog' %>">Blog</a><br />
        <a href="https://www.cpfmoteur.fr/demande-devis">Demander un devis</a>
      </div>
      <div>
        <strong>Légal</strong><br />
        <a href="#">Mentions légales</a><br />
        <a href="#">Politique de confidentialité</a>
      </div>
    </div>
  </footer>
</body>
</html>
