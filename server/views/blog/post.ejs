<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <% if (description) { %><meta name="description" content="<%= description %>"><% } %>
  <% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex,nofollow"><% } %>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <% if (ogImage) { %>
    <meta property="og:image" content="<%= ogImage %>">
    <meta name="twitter:image" content="<%= ogImage %>">
  <% } %>
  <meta property="og:title" content="<%= title %>">
  <% if (description) { %><meta property="og:description" content="<%= description %>"><% } %>
  <meta property="og:type" content="article">
  <meta property="og:url" content="<%= canonical %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <% if (description) { %><meta name="twitter:description" content="<%= description %>"><% } %>
  <% if (gsc) { %><meta name="google-site-verification" content="<%= gsc %>"><% } %>

  <link rel="stylesheet" href="<%= (typeof assetsOrigin !== 'undefined' && assetsOrigin) ? (assetsOrigin + '/assets/blog.css?v=' + Date.now()) : ('/assets/blog.css?v=' + Date.now()) %>">

  <script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: description,
    image: ogImage || undefined,
    datePublished: post?.publishedAt || undefined,
    dateModified: post?.updatedAt || undefined,
    mainEntityOfPage: canonical,
    author: post?.author || 'Car Parts France',
    publisher: {
      '@type': 'Organization',
      name: 'Car Parts France'
    }
  }) %>
  </script>

  <% if (canonical) { %>
  <script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: (origin || '').replace(/\/$/, '/') },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: (origin || '') + '/blog' },
      { '@type': 'ListItem', position: 3, name: (post?.title || title), item: canonical }
    ]
  }) %>
  </script>
  <% } %>

  <style>
    :root{
      --color-primary:#e63946; /* rouge cpfmoteur */
      --color-primary-2:#ff6b6b; /* dégradé clair */
      --color-primary-dark:#d92c3a;
      --color-background:#f8fafc;
      --color-card-bg:#ffffff;
      --color-border-light:#e5e7eb;
      --color-text-main:#0f172a;
      --color-text-muted:#6b7280;
      --font-display:'DM Sans', 'Inter', 'Segoe UI', system-ui, -apple-system;
      --font-body:'Inter', 'Segoe UI', system-ui, -apple-system;
      --color-sage:#e0f2f1;
      --color-dark:#020617;
      --color-card-glass:rgba(255,255,255,0.75);
    }
    body{font-family:var(--font-body,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif);margin:0;color:var(--color-text-main);background:var(--color-background);font-size:16px;line-height:1.6;font-weight:400;min-height:100vh}
    .container{max-width:1500px;margin:0 auto;padding:24px}
    /* Header & Footer (aligné à la home) */
    .site-header{position:sticky;top:0;z-index:50;background:#ffffffcc;backdrop-filter:saturate(140%) blur(6px);border-bottom:1px solid #e2e8f0}
    .site-header .inner{max-width:1500px;margin:0 auto;padding:10px 16px;display:flex;align-items:center;gap:16px}
    .brand{display:flex;align-items:center;gap:10px;font-weight:900;color:#0f172a;text-decoration:none}
    .brand .logo{width:34px;height:34px;border-radius:8px;background:linear-gradient(135deg,#e63946,#ff6b6b)}
    .site-nav{margin-left:auto;display:flex;gap:12px;align-items:center}
    .site-nav a{color:var(--color-text-main);text-decoration:none;padding:8px 10px;border-radius:10px}
    .site-nav a:hover{background:#f1f5f9}
    .nav-cta{background:linear-gradient(90deg,var(--color-primary),var(--color-primary-2));color:#fff !important}
    .nav-cta:hover{filter:brightness(0.95);box-shadow:0 8px 18px rgba(230,57,70,0.25)}
    .btn{display:inline-flex;align-items:center;gap:8px;border-radius:8px;padding:8px 12px;text-decoration:none}
    .btn-outline{border:1px solid var(--color-primary);color:var(--color-primary);background:#fff}
    .btn-outline:hover{background:#eaf2fd}
    .btn-success{background:rgba(37,211,102,.1);color:#22c55e;}
    .btn-success:hover{background:rgba(37,211,102,.2)}
    /* Hero minimal corporate: fond blanc, 2 colonnes */
    .hero-wrap{background:var(--color-card-bg);border:1px solid var(--color-border-light);border-left:none;border-right:none}
    .hero-wrap.has-image{background-image:var(--hero-url);background-position:center;background-size:cover;background-repeat:no-repeat;border:0}
    .hero{max-width:1500px;margin:0 auto;padding:28px 24px}
    .hero-wrap.has-image .hero{padding:42px 24px;border-radius:16px;background:linear-gradient(180deg,rgba(2,6,23,0.68),rgba(2,6,23,0.72));border:1px solid rgba(255,255,255,0.08);box-shadow:0 12px 32px rgba(2,6,23,0.45)}
    .hero-grid{display:grid;grid-template-columns:1fr;gap:18px}
    @media(min-width:1024px){.hero-grid{grid-template-columns:1fr}}
    .hero h1{font-size:32px;line-height:1.25;margin:6px 0 10px;font-weight:700;letter-spacing:-0.02em;color:var(--color-text-main)}
    @media(max-width:1023px){.hero h1{font-size:26px}}
    .hero p.sub{color:#475569;margin:0 0 10px;font-size:16px;max-width:860px}
    @media(max-width:1023px){.hero p.sub{font-size:15px}}
    .hero .meta-line{color:var(--color-text-muted);font-size:14px;line-height:1.5;margin-top:6px}
    .hero .meta-line .sep{margin:0 6px}
    .badge-pill{display:inline-block;background:#f1f5f9;border:1px solid var(--color-border-light);color:var(--color-text-main);padding:6px 12px;border-radius:999px;font-size:14px;font-weight:600;letter-spacing:.06em;text-transform:uppercase}
    .hero-wrap.has-image .badge-pill{background:rgba(255,255,255,0.12);border-color:rgba(255,255,255,0.18);color:#fff}
    .hero-wrap.has-image .hero h1{color:#fff}
    .hero-wrap.has-image .hero p.sub{color:#e2e8f0}
    .hero-wrap.has-image .hero .meta-line{color:#cbd5e1}
    .breadcrumb{gap:8px;font-size:14px;line-height:1.5;color:var(--color-text-muted)}
    .breadcrumb a{color:var(--color-text-muted);text-decoration:none}
    .breadcrumb a:hover{color:var(--color-primary);text-decoration:underline}
    .breadcrumb .sep{padding:0 6px;color:var(--color-text-muted)}
    .cta-card{background:var(--color-card-bg);border:1px solid var(--color-border-light);border-radius:16px;box-shadow:0 6px 18px rgba(15,23,42,0.05);padding:18px;transition:box-shadow .2s ease}
    .cta-card:hover{box-shadow:0 12px 24px rgba(15,23,42,0.08)}
    .cta-card h3{margin:0 0 10px;font-size:18px;color:var(--color-text-main);font-weight:700;letter-spacing:-.01em}
    .cta-card .line{display:flex;align-items:center;gap:8px;margin:6px 0;color:var(--color-text-main);font-size:14px}
    .cta-ribbon{display:none}
    .cta-head{display:flex;align-items:center;gap:10px;margin-bottom:10px}
    .cta-icon{width:40px;height:40px;border-radius:999px;background:#fff;border:1px solid var(--color-border-light);display:flex;align-items:center;justify-content:center;color:var(--color-primary)}
    .cta-icon svg{display:block}
    .cta-sub{font-size:13px;color:var(--color-text-muted)}
    .feature-list{list-style:none;margin:8px 0 12px 0;padding:0}
    .feature-list li{position:relative;padding-left:18px;margin:6px 0;font-size:14px;color:var(--color-text-main)}
    .feature-list li::before{content:"";position:absolute;left:0;top:8px;width:10px;height:10px;border-radius:2px;background:linear-gradient(90deg,#16a34a,#34d399)}
    .badge-row{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 10px}
    .badge{background:#e9eff6;border:none;border-radius:999px;padding:6px 12px;font-size:12px;color:#334155;text-transform:uppercase;letter-spacing:.01em}
    .cta-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:10px}
    .cta-actions .btn-primary{grid-column:1/-1}
    .btn-primary{display:inline-block;min-height:36px;background:linear-gradient(90deg,var(--color-primary),var(--color-primary-2));color:#fff;text-decoration:none;border-radius:14px;padding:8px 12px;font-size:13px;font-weight:700;width:100%;text-align:center;letter-spacing:.005em}
    .btn-primary:hover{filter:brightness(0.985);box-shadow:0 4px 10px rgba(230,57,70,0.18)}
    .btn-phone{display:inline-flex;align-items:center;gap:8px;min-height:40px;background:#fff;color:#0f172a;text-decoration:none;border-radius:9999px;padding:9px 14px;font-size:14px;font-weight:600;border:1px solid #e8edf3}
    .btn-wa{display:inline-flex;align-items:center;gap:8px;min-height:40px;background:linear-gradient(90deg,#22c55e,#16a34a);color:#fff;text-decoration:none;border-radius:9999px;padding:9px 14px;font-size:14px;font-weight:700}
    .btn-phone svg,.btn-wa svg{margin-right:8px}
    .btn-primary:focus-visible,.btn-phone:focus-visible,.btn-wa:focus-visible{outline:3px solid rgba(230,57,70,0.25);outline-offset:2px}
    @media(max-width:1023px){.btn-phone,.btn-wa{width:100%;justify-content:center}}
    .title{font-size:30px;line-height:1.15;margin:0 0 10px;font-weight:800;color:#0f172a}
    .meta{color:#475569;font-size:12px;margin-bottom:16px}
    .hero-img{width:100%;height:auto;border-radius:12px;border:1px solid #e2e8f0;margin:10px 0}
    .layout{display:grid;grid-template-columns:1fr;gap:28px;margin-top:8px;margin-bottom:48px}
    .layout.layout--wide{max-width:1300px;margin:0 auto}
    @media(min-width:1200px){.layout{grid-template-columns:minmax(0,0.7fr) minmax(280px,0.3fr);column-gap:36px}}
    .content{background:var(--color-card-bg);border:1px solid var(--color-border-light);border-radius:18px;box-shadow:0 20px 55px rgba(15,23,42,0.08);padding:32px}
    .article-inner{max-width:960px;margin:0 auto}
    .article-slab{position:relative;overflow:hidden}
    .content p{font-size:16px;line-height:1.7;margin:0 0 14px}
    @media(max-width:1023px){.content p{font-size:15px}}
    .content h2{font-size:24px;line-height:1.3;font-weight:600;margin:32px 0 12px}
    @media(max-width:1023px){.content h2{font-size:20px}}
    .content h3{font-size:20px;font-weight:600;margin:24px 0 8px}
    @media(max-width:1023px){.content h3{font-size:18px}}
    .content :is(h2,h3){margin-top:18px}
    .content ul,.content ol{margin:6px 0 14px 22px}
    .content li{margin:4px 0}
    .related{margin-top:18px}
    .related a{display:inline-block;margin:6px 8px 0 0;padding:8px 12px;border:1px solid #e2e8f0;border-radius:10px;color:#0f172a;text-decoration:none;background:#fff}
    .sidebar-sticky{position:relative}
    @media(min-width:1024px){.sidebar-sticky{position:sticky;top:90px;height:fit-content}}
    .toc-card{background:var(--color-card-glass);backdrop-filter:blur(24px);border:1px solid rgba(226,232,240,0.6);border-radius:20px;box-shadow:0 18px 45px rgba(15,23,42,0.12);padding:20px;margin-bottom:18px}
    .toc-card h3{margin:0 0 8px;font-size:15px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#475569;display:flex;align-items:center;justify-content:space-between}
    .toc{margin:0;padding:0}
    .toc ul{margin:0;padding-left:18px}
    .toc a{color:#475569;text-decoration:none;display:block;padding:6px 0;font-size:14px}
    .toc a.active{font-weight:700;color:#0ea5e9}
    .sidebar-card{background:var(--color-card-bg);border:1px solid var(--color-border-light);border-radius:14px;padding:16px;box-shadow:0 8px 28px rgba(15,23,42,0.06)}
    .sidebar-cta-card{background:linear-gradient(160deg,#0f172a,#1e293b);color:#fff;border-radius:22px;padding:22px;box-shadow:0 25px 45px rgba(2,6,23,0.35)}
    .sidebar-cta-card .line{display:flex;align-items:center;gap:10px;margin:8px 0;font-size:14px}
    .sidebar-cta-card a{color:#fff;font-weight:700;text-decoration:none}
    .sidebar-cta-card .btn-primary{width:auto;min-width:0;display:inline-flex;align-items:center;justify-content:center;padding:8px 14px;font-size:13px;line-height:1;border-radius:999px}
    @media(max-width:1023px){.sidebar-cta-card .btn-primary{width:100%}}
    .cta-box{margin-top:16px;background:linear-gradient(45deg,#e63946 0%,#ff6b6b 100%);color:#fff;border-radius:14px;padding:14px}
    .cta-btn{display:inline-block;margin-top:8px;background:linear-gradient(90deg,var(--color-primary),var(--color-primary-2));color:#fff;text-decoration:none;padding:10px 14px;border-radius:999px;font-weight:700}
    /* Rendu visuel PRO pour le contenu généré */
    .content table{width:100%;border-collapse:collapse;margin:12px 0;font-size:15px}
    .content thead th{background:#f1f5f9;color:#0f172a}
    .content th,.content td{border:1px solid #e2e8f0;padding:10px;text-align:left;vertical-align:top}
    .content tbody tr:nth-child(odd){background:#fafafa}
    .content aside{border:1px solid #e2e8f0;background:#fafafa;border-radius:10px;padding:12px;margin:12px 0}
    .content aside.attention{border-color:#f5c2c7;background:#fff5f5}
    .content details{border:1px solid #e2e8f0;border-radius:10px;background:#fff;padding:8px 12px;margin:12px 0}
    .content details summary{cursor:pointer;font-weight:700;outline:none}
    .content img{max-width:100%;height:auto;border-radius:10px;border:1px solid #e2e8f0}
    .content ul{padding-left:20px}
    .content li{margin:6px 0}
    /* Breadcrumb + partage + progression */
    .breadcrumb{display:flex;align-items:center;gap:6px;color:#475569;font-size:12px;margin:4px 0 10px}
    .breadcrumb a{color:#0f172a;text-decoration:none}
    .breadcrumb .sep{opacity:0.5}
    .share{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0}
    .share-pill{border:1px solid #e2e8f0;background:#fff;padding:8px 14px;border-radius:999px;font-size:13px;color:#0f172a;text-decoration:none;cursor:pointer;display:inline-flex;align-items:center;gap:8px;transition:background .15s,box-shadow .15s}
    .share-pill svg{width:16px;height:16px}
    .share-pill:hover{background:#f8fafc;box-shadow:0 4px 10px rgba(15,23,42,0.08)}
    .progress{position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,#0ea5e9,#22c55e);width:0;z-index:9999;transition:width .1s linear}
    /* CTA mobile collante */
    .sticky-cta{position:fixed;left:12px;right:12px;bottom:12px;background:#0ea5e9;color:#fff;border-radius:999px;padding:12px 16px;text-align:center;font-weight:800;box-shadow:0 12px 30px rgba(2,6,23,.25);z-index:9997}
    .sticky-cta a{color:#fff;text-decoration:none}
    .cta-sticky-desktop{display:none}
    @media(min-width:1024px){
      .sticky-cta{display:none}
      .cta-sticky-desktop{position:fixed;right:32px;bottom:32px;background:linear-gradient(120deg,#e63946,#ff6b6b);color:#fff;padding:18px 26px;border-radius:999px;font-weight:800;text-decoration:none;box-shadow:0 20px 40px rgba(230,57,70,0.35);display:inline-flex;align-items:center;gap:10px;z-index:9997}
      .cta-sticky-desktop svg{width:18px;height:18px}
    }
    /* Badges d'info et tags cliquables */
    .badges{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0 8px}
    .badge{display:inline-block;background:#e2e8f0;color:#0f172a;border-radius:999px;padding:4px 10px;font-size:12px}
    .tags{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 10px}
    .tag-chip{display:inline-block;border:1px solid #e2e8f0;background:#fff;border-radius:999px;padding:6px 10px;font-size:12px;text-decoration:none;color:#0f172a}
    .tag-chip:hover{background:#f8fafc}
    /* Tables responsives */
    .table-wrap{overflow-x:auto;border:1px solid #e2e8f0;border-radius:10px}
    .table-wrap table{margin:0}
    /* Cartes articles liés */
    .related-grid{display:grid;gap:16px;grid-template-columns:1fr}
    .related-slider{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(240px,300px);gap:16px;overflow-x:auto;padding-bottom:8px;scroll-snap-type:x mandatory}
    .card{border:1px solid #e2e8f0;border-radius:16px;overflow:hidden;background:#fff;display:flex;flex-direction:column;min-height:100%;scroll-snap-align:start;box-shadow:0 16px 38px rgba(15,23,42,0.12)}
    .card img{width:100%;height:180px;object-fit:cover;border:0}
    .card .card-body{padding:16px;display:flex;flex-direction:column;gap:8px}
    .card .card-title{font-weight:800;color:#0f172a;margin:0;font-size:17px;line-height:1.35}
    .card .card-meta{font-size:12px;color:#64748b;display:flex;gap:8px;flex-wrap:wrap}
    /* Navigation précédent/suivant */
    .prevnext{display:flex;justify-content:space-between;gap:12px;margin-top:18px;flex-wrap:wrap}
    .prevnext a{flex:1;display:block;border:1px solid #e2e8f0;border-radius:10px;padding:10px;text-decoration:none;color:#0f172a;background:#fff}
    .prevnext a small{display:block;color:#64748b}
    /* Auteur / mise à jour */
    .author-box{margin-top:16px;border:1px solid #e2e8f0;border-radius:12px;padding:12px;background:#fff}
    .author-box .name{font-weight:800}
    .author-box .date{font-size:12px;color:#64748b}
    .metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-top:18px}
    .metric-card{background:#fff;border:1px solid rgba(226,232,240,0.8);border-radius:16px;padding:18px;box-shadow:0 14px 30px rgba(15,23,42,0.08)}
    .metric-card span{display:block;font-size:13px;color:#64748b;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px}
    .metric-card strong{font-size:22px;color:#0f172a}
    .testimonials{margin:28px 0;padding:28px;border:1px solid rgba(226,232,240,0.8);border-radius:22px;background:linear-gradient(145deg,#fff,#f8fafc);box-shadow:0 18px 45px rgba(15,23,42,0.08)}
    .testimonials h2{margin-top:0}
    .testimonials-grid{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
    .testimonial-card{background:#fff;border-radius:18px;padding:18px;border:1px solid #e2e8f0;box-shadow:0 12px 24px rgba(15,23,42,0.08)}
    .testimonial-card .quote{font-style:italic;color:#334155;margin-bottom:10px}
    .testimonial-card .author{font-weight:700;color:#0f172a}
    /* Lightbox */
    .lightbox{position:fixed;inset:0;background:rgba(2,6,23,.8);display:none;align-items:center;justify-content:center;padding:16px;z-index:9998}
    .lightbox.open{display:flex}
    .lightbox img{max-width:95vw;max-height:85vh;border-radius:12px;border:1px solid #334155}
    .lightbox .caption{color:#e2e8f0;margin-top:8px;text-align:center}
    /* Ancre H2 (copier lien) */
    .h2-anchor{margin-left:8px;font-size:12px;opacity:0.6;text-decoration:none}
    .h2-anchor:hover{opacity:1}
    /* TOC mobile repliable */
    .toc-toggle{display:none;border:1px solid #e2e8f0;background:#fff;border-radius:999px;padding:6px 10px;font-size:12px;cursor:pointer}
    @media(max-width:1023px){.toc-toggle{display:inline-block}.toc.collapsed ul{display:none}}
    /* Footer */
    .site-footer{margin-top:28px;background:#0f172a;color:#e2e8f0}
    .site-footer .inner{max-width:1500px;margin:0 auto;padding:22px 16px;display:grid;gap:18px;grid-template-columns:1fr}
    @media(min-width:900px){.site-footer .inner{grid-template-columns:2fr 1fr 1fr}}
    .site-footer a{color:#e2e8f0;text-decoration:none}
    .site-footer a:hover{text-decoration:underline}
    /* Footer pro */
    .footer-grid{grid-template-columns:1fr}
    @media(min-width:900px){.footer-grid{grid-template-columns:2fr 1fr 1fr}}
    .brand-line{display:flex;align-items:center;gap:10px;margin-bottom:8px}
    .site-footer .logo{width:28px;height:28px;border-radius:6px;background:linear-gradient(135deg,#e63946,#ff6b6b)}
    .footer-desc{opacity:.9;font-size:14px;margin:0}
    .footer-contact{list-style:none;padding:0;margin:10px 0 0}
    .footer-contact li{margin:6px 0;font-size:14px}
    .footer-title{margin:0 0 8px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#cbd5e1}
    .footer-list{list-style:none;padding:0;margin:0}
    .footer-list li{margin:6px 0}
    .footer-list a{color:#e2e8f0;text-decoration:none}
    .footer-list a:hover{color:#ffffff;text-decoration:underline}
    .footer-bottom{border-top:1px solid rgba(255,255,255,0.15);margin-top:12px}
    .footer-bottom .inner{padding-top:12px;display:flex;justify-content:space-between;gap:10px;align-items:center}
    @media(max-width:600px){.footer-bottom .inner{flex-direction:column;align-items:flex-start;gap:6px}}

    /* ===== Responsive: pages articles ===== */
    @media(max-width:1024px){
      .container{padding:18px}
      .hero-wrap.has-image .hero{padding:28px 18px}
      .layout{grid-template-columns:1fr}
      .sidebar-sticky{position:static}
      .cta-actions{grid-template-columns:1fr}
    }
    @media(max-width:768px){
      .site-header .inner{flex-wrap:wrap;gap:8px}
      .site-nav{flex-wrap:wrap;row-gap:6px}
      .site-nav a{padding:6px 8px}
      .nav-cta{padding:8px 12px}
      .title{font-size:24px}
      .hero .meta-line{font-size:12px}
      .btn-primary{width:100%}
      .btn-phone,.btn-wa{width:100%;justify-content:center}
      .related-slider{grid-auto-columns:minmax(220px,260px)}
    }
    @media(max-width:480px){
      .container{padding:16px 12px}
      .share-pill{padding:8px 12px;font-size:12px}
      .hero-img{border-radius:10px}
      .toc-card{padding:14px}
      .sidebar-card{padding:12px}
    }
  </style>
</head>
<body>
  <div id="progress" class="progress"></div>
  <header class="site-header">
    <div class="inner">
      <a class="brand" href="<%= (origin || '').replace(/\/$/, '/') %>">
