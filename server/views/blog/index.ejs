<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <% if (description) { %><meta name="description" content="<%= description %>"><% } %>
  <% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <% if (prevUrl) { %><link rel="prev" href="<%= (origin || '') + prevUrl %>"><% } %>
  <% if (nextUrl) { %><link rel="next" href="<%= (origin || '') + nextUrl %>"><% } %>
  <meta property="og:title" content="<%= title %>">
  <% if (description) { %><meta property="og:description" content="<%= description %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= canonical %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <% if (description) { %><meta name="twitter:description" content="<%= description %>"><% } %>
  <% if (gsc) { %><meta name="google-site-verification" content="<%= gsc %>"><% } %>
  <style>
    body{font-family:-apple-system,system-ui,Segoe UI,Roboto,Ubuntu,Cantarell,Noto Sans,sans-serif;margin:0;color:#0f172a;background:#f8fafc}
    .container{max-width:1040px;margin:0 auto;padding:24px}
    .title{font-size:30px;line-height:1.15;margin:0 0 12px;font-weight:800;color:#0f172a}
    .grid{display:grid;gap:16px;grid-template-columns:1fr}
    @media(min-width:960px){.grid{grid-template-columns:repeat(2,1fr)}}
    .card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;box-shadow:0 8px 28px rgba(15,23,42,0.06);padding:16px}
    .card h2{margin:0 0 6px;font-size:18px}
    .meta{color:#475569;font-size:12px;margin-bottom:8px}
    .link{display:inline-block;margin-top:8px;text-decoration:none;color:#0f172a;border:1px solid #e2e8f0;border-radius:10px;padding:8px 12px;background:#fff}
    .thumb{width:100%;height:auto;border-radius:10px;border:1px solid #e2e8f0;margin-bottom:8px}
  </style>
</head>
<body>
  <div class="container">
    <h1 class="title"><%= title %></h1>
    <% if (description) { %><p class="meta"><%= description %></p><% } %>
    <div class="grid">
      <% (items||[]).forEach(function(p){ %>
        <div class="card">
          <% if (p.image) { %>
            <img loading="lazy" class="thumb" src="<%= p.image %>" alt="<%= p.title %>">
          <% } %>
          <h2><a href="/blog/<%= p.slug %>" style="text-decoration:none;color:#0f172a"><%= p.title %></a></h2>
          <% if (p.publishedAt) { %><div class="meta">Publié le <%= new Date(p.publishedAt).toLocaleDateString('fr-FR') %></div><% } %>
          <div><%= p.summary || '' %></div>
          <a class="link" href="/blog/<%= p.slug %>">Lire l’article</a>
        </div>
      <% }) %>
    </div>
    <% if (typeof total !== 'undefined' && typeof limit !== 'undefined') { const max = Math.ceil((total||0)/(limit||1)); if (max > 1) { %>
      <div style="margin-top:16px">
        <% if (page > 1) { %>
          <a class="link" href="<%= pathUrl %>?page=<%= page-1 %>&limit=<%= limit %>">← Précédent</a>
        <% } %>
        <% if (page < max) { %>
          <a class="link" href="<%= pathUrl %>?page=<%= page+1 %>&limit=<%= limit %>">Suivant →</a>
        <% } %>
      </div>
    <% } } %>
  </div>
</body>
</html>
