<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <% if (description) { %><meta name="description" content="<%= description %>"><% } %>
  <% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <% if (prevUrl) { %><link rel="prev" href="<%= (origin || '') + prevUrl %>"><% } %>
  <% if (nextUrl) { %><link rel="next" href="<%= (origin || '') + nextUrl %>"><% } %>
  <meta property="og:title" content="<%= title %>">
  <% if (description) { %><meta property="og:description" content="<%= description %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= canonical %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <% if (description) { %><meta name="twitter:description" content="<%= description %>"><% } %>
  <% if (gsc) { %><meta name="google-site-verification" content="<%= gsc %>"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="<%= (typeof assetsOrigin !== 'undefined' && assetsOrigin) ? (assetsOrigin + '/assets/blog.css?v=' + Date.now()) : ('/assets/blog.css?v=' + Date.now()) %>">
</head>
<body class="blog-page">
  <header class="site-header">
    <div class="inner">
      <a class="brand" href="<%= (origin || '').replace(/\/$/, '/') %>">
        <img src="<%= (origin || '').replace(/\/$/, '') %>/images/logo.png" alt="Car Parts France" style="height:50px; width:auto; border-radius:6px" />
        <span>Car Parts France</span>
      </a>
      <nav class="site-nav">
        <a href="<%= (origin || '').replace(/\/$/, '/') %>">Accueil</a>
        <a href="<%= (origin || '') + '/a-propos' %>">À propos</a>
        <a href="<%= (origin || '') + '/contact' %>">Contact</a>
        <a href="https://www.cpfmoteur.fr/demande-devis" class="nav-cta">Demander un devis</a>
        <a class="btn btn-outline" href="tel:0465845488">📞 04 65 84 54 88</a>
        <a class="btn btn-success" href="https://wa.me/330756875025" target="_blank" rel="noopener">🟢 WhatsApp</a>
      </nav>
    </div>
  </header>

  <main class="blog-hero">
    <div class="blog-hero__grid container">
      <div>
        <span class="badge-pill">ACTUALITÉS CPF MOTEUR</span>
        <h1>Blog moteurs, pannes et conseils d’entretien</h1>
        <p>Analyses techniques, moteurs testés et retours d’expérience atelier pour guider vos décisions.</p>
        <div class="blog-hero__stats">
          <div>
            <span><%= total || 0 %></span>
            <small>Articles en ligne</small>
          </div>
          <div>
            <% const tagSet = new Set(); (items||[]).forEach(function(p){ (Array.isArray(p.tags)?p.tags:[]).forEach(function(t){ tagSet.add(String(t)); }); }); const tags = Array.from(tagSet); %>
            <span><%= tags.length %></span>
            <small>Tags actifs</small>
          </div>
          <div>
            <span>24h</span>
            <small>Réponse moyenne devis</small>
          </div>
        </div>
      </div>
      <div class="blog-hero__cta">
        <div class="cta-card">
          <div class="cta-head">
            <div class="cta-icon">⚙️</div>
            <div>
              <strong>Besoin d’un moteur ?</strong>
              <div class="cta-sub">Compatibilité confirmée via VIN</div>
            </div>
          </div>
          <ul class="feature-list">
            <li>Tests compression / endoscopie</li>
            <li>Garantie 12 mois</li>
            <li>Logistique France sous 4-5 jours</li>
          </ul>
          <div class="cta-actions">
            <a class="btn-primary" href="https://www.cpfmoteur.fr/demande-devis">Demander un devis</a>
            <a class="btn-phone" href="tel:0465845488">📞 04 65 84 54 88</a>
            <a class="btn-wa" href="https://wa.me/330756875025" target="_blank" rel="noopener">WhatsApp direct</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <section class="blog-content container">
    <div class="blog-main">
      <header class="blog-main__head">
        <div>
          <h2>Derniers articles</h2>
          <p>Cas clients, fiches moteurs, prévention des pannes et guides d’entretien.</p>
        </div>
      </header>

      <% if (!items || !items.length) { %>
        <div class="blog-empty">
          <p>Aucun article n’est encore publié. Revenez bientôt !</p>
          <a class="btn-primary" href="https://www.cpfmoteur.fr/demande-devis">Contacter l’équipe</a>
        </div>
      <% } %>

      <div class="blog-cards">
        <% (items||[]).forEach(function(p){ %>
          <article class="blog-card">
            <% if (p.image) { %>
              <img src="<%= p.image %>" alt="<%= p.title %>" loading="lazy" decoding="async" />
            <% } else { %>
              <div class="blog-card__placeholder">CPF</div>
            <% } %>
            <div class="blog-card__body">
              <% if (Array.isArray(p.tags) && p.tags.length) { %>
                <div class="blog-card-tags">
                  <% p.tags.slice(0,3).forEach(function(tag){ %>
                    <span class="blog-card-tag">#<%= tag %></span>
                  <% }) %>
                </div>
              <% } %>
              <h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3>
              <p><%= (p.summary || '').slice(0, 180) %><%= (p.summary||'').length>180 ? '…' : '' %></p>
              <div class="blog-card-meta">
                <% if (p.publishedAt) { %><span>Publié le <%= new Date(p.publishedAt).toLocaleDateString('fr-FR') %></span><% } %>
                <span>Lecture rapide</span>
              </div>
              <a class="blog-card-link" href="/blog/<%= p.slug %>">Lire l’article →</a>
            </div>
          </article>
        <% }) %>
      </div>

      <% if (typeof total !== 'undefined' && typeof limit !== 'undefined') {
          const max = Math.ceil((total||0)/(limit||1));
          if (max > 1) { %>
        <nav class="pagination" aria-label="Pagination blog">
          <% if (page > 1) { %>
            <a href="<%= pathUrl %>?page=<%= page-1 %>&limit=<%= limit %>">← Précédent</a>
          <% } else { %>
            <span class="pagination__disabled">← Précédent</span>
          <% } %>
          <span>Page <%= page %> / <%= max %></span>
          <% if (page < max) { %>
            <a href="<%= pathUrl %>?page=<%= page+1 %>&limit=<%= limit %>">Suivant →</a>
          <% } else { %>
            <span class="pagination__disabled">Suivant →</span>
          <% } %>
        </nav>
      <% } } %>
    </div>

    <aside class="blog-sidebar">
      <section class="blog-panel">
        <h3>Explorer par tags</h3>
        <% if (tags.length) { %>
          <div class="blog-tags-list">
            <% tags.slice(0, 15).forEach(function(tag){ %>
              <a class="blog-tag-link" href="/blog/tag/<%= encodeURIComponent(String(tag).toLowerCase()) %>">#<%= tag %></a>
            <% }) %>
          </div>
        <% } else { %>
          <p>Aucun tag disponible pour le moment.</p>
        <% } %>
      </section>

      <section class="blog-panel blog-sidebar-cta">
        <h3>Assistance experte</h3>
        <p>Besoin de vérifier un moteur ou un VIN ? Nos techniciens vous répondent en quelques heures.</p>
        <ul>
          <li>Compatibilité confirmée</li>
          <li>Rapport de tests détaillé</li>
          <li>Logistique France & DOM</li>
        </ul>
        <a class="btn-primary" href="https://www.cpfmoteur.fr/demande-devis">Parler à un expert</a>
      </section>
    </aside>
  </section>

  <%- include('../partials/footer', { origin }) %>
</body>
</html>
