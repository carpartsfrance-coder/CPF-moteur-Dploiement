<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <% if (description) { %><meta name="description" content="<%= description %>"><% } %>
  <% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <% if (prevUrl) { %><link rel="prev" href="<%= (origin || '') + prevUrl %>"><% } %>
  <% if (nextUrl) { %><link rel="next" href="<%= (origin || '') + nextUrl %>"><% } %>
  <meta property="og:title" content="<%= title %>">
  <% if (description) { %><meta property="og:description" content="<%= description %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= canonical %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <% if (description) { %><meta name="twitter:description" content="<%= description %>"><% } %>
  <% if (gsc) { %><meta name="google-site-verification" content="<%= gsc %>"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="<%= (typeof assetsOrigin !== 'undefined' && assetsOrigin) ? (assetsOrigin + '/assets/blog.css?v=' + Date.now()) : ('/assets/blog.css?v=' + Date.now()) %>">
</head>
<body class="blog-page">
  <header class="site-header">
    <div class="inner">
      <a class="brand" href="<%= (origin || '').replace(/\/$/, '/') %>">
        <img src="<%= (origin || '').replace(/\/$/, '') %>/images/logo.png" alt="Car Parts France" style="height:50px; width:auto; border-radius:6px" />
        <span>Car Parts France</span>
      </a>
      <button class="menu-toggle" type="button" aria-label="Ouvrir le menu">☰ Menu</button>
      <nav class="site-nav">
        <a href="<%= (origin || '').replace(/\/$/, '/') %>">Accueil</a>
        <a href="<%= (origin || '') + '/a-propos' %>">À propos</a>
        <a href="<%= (origin || '') + '/tests-moteurs' %>">Tests moteurs</a>
        <a href="<%= (origin || '') + '/contact' %>">Contact</a>
        <a href="https://www.cpfmoteur.fr/demande-devis" class="nav-cta">Demander un devis</a>
        <a class="btn btn-outline" href="tel:0465845488">📞 04 65 84 54 88</a>
        <a class="btn btn-success" href="https://wa.me/330756875025" target="_blank" rel="noopener">🟢 WhatsApp</a>
      </nav>
    </div>
  </header>

  <% const tagSet = new Set(); (items||[]).forEach(function(p){ (Array.isArray(p.tags)?p.tags:[]).forEach(function(t){ tagSet.add(String(t)); }); });
     const tags = Array.from(tagSet);
     const featured = (items && items.length) ? items[0] : null;
     const feedItems = featured ? items.slice(1) : [];
     const fallbackImage = '/assets/blog-cover.svg'; %>

  <main class="blog-layout">
    <section class="blog-hero container">
      <div class="hero-content">
        <p class="hero-eyebrow">ATELIER CPF MOTEUR</p>
        <h1>Analyses moteurs, cas clients et conseils d’entretien</h1>
        <p>Retrouvez l’expertise de notre atelier sur les pannes récurrentes, les compatibilités VIN et les process de tests compression / endoscopie.</p>
        <div class="hero-metrics">
          <div class="metric-card">
            <span><%= total || 0 %></span>
            <small>Articles experts</small>
          </div>
          <div class="metric-card">
            <span><%= tags.length %></span>
            <small>Tags moteurs actifs</small>
          </div>
          <div class="metric-card">
            <span>4h</span>
            <small>Temps moyen de réponse</small>
          </div>
        </div>
        <div class="hero-cta">
          <a class="btn-primary" href="https://www.cpfmoteur.fr/demande-devis">Demander un devis</a>
          <a class="btn-outline" href="tel:0465845488">Parler à un expert</a>
        </div>
      </div>
      <div class="hero-card">
        <span class="hero-badge">Support atelier</span>
        <h3>Équipe technique dédiée</h3>
        <p>Nos techniciens valident chaque compatibilité (VIN / code) et transmettent un rapport complet avant expédition.</p>
        <ul class="hero-checklist">
          <li>Tests compression & leak-down certifiés</li>
          <li>Endoscopie des chambres et contrôle visuel</li>
          <li>Garantie Europe 12 mois (pièce + assistance)</li>
        </ul>
        <div class="hero-card-cta">
          <a class="btn-outline" href="tel:0465845488">📞 04 65 84 54 88</a>
          <a class="btn-primary" href="https://wa.me/330756875025" target="_blank" rel="noopener">WhatsApp atelier →</a>
        </div>
      </div>
    </section>

    <section class="blog-feed container">
      <div class="feed-main">
        <% if (!items || !items.length) { %>
          <div class="blog-empty">
            <h3>Articles en préparation</h3>
            <p>Nos experts finalisent du contenu. Revenez très vite ou contactez-nous pour une étude personnalisée.</p>
            <a class="btn-primary" href="https://www.cpfmoteur.fr/demande-devis">Contacter l’équipe</a>
          </div>
        <% } else { %>
          <% if (featured) { %>
            <article class="featured-article">
              <a class="featured-media" href="/blog/<%= featured.slug %>">
                <img src="<%= featured.image || fallbackImage %>" alt="<%= featured.title %>">
              </a>
              <div class="featured-body">
                <% if (Array.isArray(featured.tags) && featured.tags.length) { %>
                  <div class="article-tags">
                    <% featured.tags.slice(0,3).forEach(function(tag){ %>
                      <span>#<%= tag %></span>
                    <% }) %>
                  </div>
                <% } %>
                <h2><a href="/blog/<%= featured.slug %>"><%= featured.title %></a></h2>
                <p><%= (featured.summary || '').slice(0, 240) %><%= (featured.summary||'').length>240 ? '…' : '' %></p>
                <div class="article-meta">
                  <% if (featured.publishedAt) { %><span>Publié le <%= new Date(featured.publishedAt).toLocaleDateString('fr-FR') %></span><% } %>
                  <span>Lecture atelier</span>
                </div>
                <a class="btn-outline" href="/blog/<%= featured.slug %>">Lire l’analyse</a>
              </div>
            </article>
          <% } %>

          <% if (feedItems.length) { %>
            <div class="article-grid">
              <% feedItems.forEach(function(p){ %>
                <article class="article-card">
                  <a href="/blog/<%= p.slug %>" class="article-thumb">
                    <img src="<%= p.image || fallbackImage %>" alt="<%= p.title %>" loading="lazy" decoding="async" />
                  </a>
                  <div class="article-content">
                    <% if (Array.isArray(p.tags) && p.tags.length) { %>
                      <div class="article-tags">
                        <% p.tags.slice(0,3).forEach(function(tag){ %>
                          <span>#<%= tag %></span>
                        <% }) %>
                      </div>
                    <% } %>
                    <h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3>
                    <p><%= (p.summary || '').slice(0, 160) %><%= (p.summary||'').length>160 ? '…' : '' %></p>
                    <div class="article-meta">
                      <% if (p.publishedAt) { %><span><%= new Date(p.publishedAt).toLocaleDateString('fr-FR') %></span><% } %>
                      <span>Lecture rapide</span>
                    </div>
                    <a class="card-link" href="/blog/<%= p.slug %>">Lire l’article →</a>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>

          <% if (typeof total !== 'undefined' && typeof limit !== 'undefined') {
              const max = Math.ceil((total||0)/(limit||1));
              if (max > 1) { %>
            <nav class="pagination" aria-label="Pagination blog">
              <% if (page > 1) { %>
                <a href="<%= pathUrl %>?page=<%= page-1 %>&limit=<%= limit %>">← Précédent</a>
              <% } else { %>
                <span class="pagination__disabled">← Précédent</span>
              <% } %>
              <span>Page <%= page %> / <%= max %></span>
              <% if (page < max) { %>
                <a href="<%= pathUrl %>?page=<%= page+1 %>&limit=<%= limit %>">Suivant →</a>
              <% } else { %>
                <span class="pagination__disabled">Suivant →</span>
              <% } %>
            </nav>
          <% } } %>
        <% } %>
      </div>

      <aside class="feed-aside">
        <div class="aside-card">
          <h3>Explorer par tags</h3>
          <% if (tags.length) { %>
            <div class="tag-list">
              <% tags.slice(0, 18).forEach(function(tag){ %>
                <a href="/blog/tag/<%= encodeURIComponent(String(tag).toLowerCase()) %>">#<%= tag %></a>
              <% }) %>
            </div>
          <% } else { %>
            <p>Aucun tag disponible pour le moment.</p>
          <% } %>
        </div>

        <div class="aside-card contact-card">
          <h3>Assistance moteur</h3>
          <p>Compatibilité VIN, stock et délai d’expédition confirmés par notre équipe commerciale.</p>
          <a class="btn-primary" href="tel:0465845488">04 65 84 54 88</a>
          <a class="btn-outline" href="https://wa.me/330756875025" target="_blank" rel="noopener">WhatsApp atelier</a>
        </div>
      </aside>
    </section>
  </main>

  <%- include('../partials/footer', { origin }) %>
  <script>
    (function(){
      try{
        var header = document.querySelector('.site-header');
        var btn = header && header.querySelector('.menu-toggle');
        if(btn){ btn.addEventListener('click', function(){ header.classList.toggle('is-open'); }); }
      }catch(e){}
    })();
  </script>
</body>
</html>
