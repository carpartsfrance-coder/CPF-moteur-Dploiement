  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "axios": "^1.8.4",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "formik": "^2.4.6",
    "framer-motion": "^12.7.4",
    "mailersend": "^2.6.0",
    "mongodb": "^6.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.1",
    "react-scripts": "5.0.1",
    "react-scroll": "^1.9.3",
    "serve": "^14.2.1",
    "sharp": "^0.34.5",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "yup": "^1.6.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "rm -rf node_modules/.cache && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "start:static": "serve -s build -l $PORT",
    "start:server": "node server/index.js",
    "dev:client": "react-scripts start",
    "dev:server": "cd server && npm run dev",
    "dev": "kill-port 3000 3001 || true && concurrently -n client,server -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "preview": "npm run build && PORT=3000 npm run start:static",
    "dev:local": "kill-port 3000 3001 || true && concurrently -n server,static -c magenta,cyan \"npm run dev:server\" \"npm run preview\""
  },
  "proxy": "http://localhost:3001",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react-scroll": "^1.8.10",
    "concurrently": "^9.2.1",
    "http-proxy-middleware": "^3.0.5",
    "kill-port": "^2.0.1"
  },
  "overrides": {},
  "resolutions": {}
}
